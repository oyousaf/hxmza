{
  "name": "beds4u",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed": "pnpm --filter @dtc/backend exec medusa exec ./src/scripts/seed.ts",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "storefront:dev": "turbo dev --filter=@dtc/storefront",
    "typecheck": "pnpm --filter @dtc/storefront exec tsc --noEmit"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5",
      "ajv@>=7.0.0-alpha.0 <8.18.0": ">=8.18.0",
      "lodash@>=4.0.0 <=4.17.23": ">=4.18.0",
      "lodash@<=4.17.23": ">=4.18.0",
      "postcss@<8.5.10": ">=8.5.10",
      "uuid@<11.1.1": ">=11.1.1",
      "sharp@<0.35.0": ">=0.35.0",
      "postcss@<=8.5.11": ">=8.5.12",
      "postcss@<=8.5.22": ">=8.5.23",
      "postcss@<=8.5.17": ">=8.5.18",
      "qs@>=6.14.2 <=6.15.3": ">=6.16.0",
      "qs@>=2.2.5 <6.16.0": ">=6.16.0",
      "csv-parse@<7.0.2": ">=7.0.2",
      "sharp@<0.35.4": ">=0.35.4",
      "js-yaml@3": ">=3.15.2",
      "js-yaml@4": ">=4.3.2",
      "multer@<2.3.0": ">=2.3.0",
      "multer@=2.2.0": ">=2.3.0",
      "morgan@<1.12.0": ">=1.12.0"
    }
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.20.1",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.14"
  }
}
